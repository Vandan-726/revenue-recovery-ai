# Server runtime
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
API_PORT=3001
BASE_PATH=/
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Phase 3: OpenRouter is optional; rules fallback is used when unset.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Phase 3 recovery tuning
MAX_RETRIES=3
MAX_DISCOUNT_AMOUNT=500
DISCOUNT_VALIDITY_HOURS=24
HIGH_VALUE_THRESHOLD=5000
ESCALATION_THRESHOLD=10000
RECOVERY_DEMO_SPEED=120
RECOVERY_MAX_DELAY_MS=8000
RECOVERY_PAYMENT_LINK=https://your-domain.example/update-payment

# Phase 4 provider selection and credentials. Leave blank to use simulation mode.
SMS_PROVIDER=simulation
EMAIL_PROVIDER=simulation
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
SES_FROM_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
